{
  "name": "barber-booking-vanilla-frontend",
  "version": "1.0.0",
  "description": "Vanilla JS & Tailwind CSS Frontend for Salon & Barber Booking SaaS",
  "main": "index.html",
  "scripts": {
    "build:css": "tailwindcss -i ./src/css/input.css -o ./src/css/output.css --minify",
    "dev": "tailwindcss -i ./src/css/input.css -o ./src/css/output.css --watch",
    "serve": "npx live-server --port=3000 ."
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14"
  }
}

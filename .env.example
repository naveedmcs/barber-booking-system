# Infrastructure & Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/barber_saas?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=barber_user
SPRING_DATASOURCE_PASSWORD=your_secure_db_password
SPRING_DATASOURCE_ROOT_PASSWORD=your_secure_root_password
MYSQL_DATABASE=barber_saas
MYSQL_PORT=3306

# Redis Cache & Redisson
SPRING_DATA_REDIS_URL=redis://127.0.0.1:6379
REDIS_PORT=6379

# JWT Security (Minimum 32 bytes key for HMAC-SHA256/512)
JWT_SECRET=replace_with_a_secure_32_byte_secret_key_string_here
JWT_EXPIRATION_MS=86400000

# Payment Gateway (Moyasar / Stripe Integration)
MOYASAR_API_KEY=pk_test_your_moyasar_public_key
MOYASAR_SECRET_KEY=sk_test_your_moyasar_secret_key
PAYMENT_WEBHOOK_SECRET=whsec_your_webhook_secret_key

# Application & API Ports
SERVER_PORT=8080
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws/websocket
